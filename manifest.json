{
  "manifest_version": 3,
  "name": "Scorly - SEO Score & OG Preview",
  "version": "1.0.0",
  "description": "Free, open source, no account, no subscription. Get instant SEO analysis, on-page insights, and social share previews for any site, including localhost.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Scorly"
  },
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "scorly@extensions.local",
      "strict_min_version": "109.0"
    }
  }
}
